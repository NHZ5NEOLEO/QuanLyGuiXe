{
	"info": {
		"_postman_id": "parking-management-api-collection",
		"name": "Phần Mềm Quản Lý Gửi Xe - REST API Collection",
		"description": "Bộ sưu tập kiểm thử toàn diện cho hệ thống Quản lý gửi xe thông minh (Spring Boot + SQL Server + ZXing QR + Thymeleaf). Hỗ trợ kiểm thử đầy đủ các nghiệp vụ Check-in, Check-out, QR Code, Tính phí, Quản lý phương tiện và Báo cáo doanh thu.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
